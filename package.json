{
  "name": "purebiome",
  "private": true,
  "version": "0.1.0",
  "description": "PureBiome — Next.js storefront + Medusa commerce backend monorepo.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" --filter \"./services/*\" run dev",
    "dev:storefront": "pnpm --filter ./apps/storefront run dev",
    "dev:medusa": "pnpm --filter ./services/medusa run dev",
    "medusa:seed": "pnpm --filter ./services/medusa run seed",
    "medusa:migrate": "pnpm --filter ./services/medusa exec medusa db:migrate",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.3"
  }
}
