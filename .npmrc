# pnpm workspace hoisting for Medusa v2 admin (Vite) build.
# The Medusa admin bundle imports @medusajs/dashboard and @medusajs/*/admin
# transitively; pnpm's strict linker doesn't expose these to Vite by default.
# These patterns ensure they're visible in the top-level node_modules.
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
